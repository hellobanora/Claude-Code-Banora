# ── Existing — already in use ──────────────────────────────────────────
RESEND_API_KEY=            # Resend API key — contact form, booking confirmation, health-check alerts, seo-agent report emails
ICONPRACTICE_TOKEN1=       # IconPractice widget ob_token (booking proxy)
ICONPRACTICE_TOKEN2=       # IconPractice widget ob_token2 (booking proxy)
CRON_SECRET=                # Shared bearer-token secret checked by every /api/cron/* route (health-check, seo-agent, seo-agent-reply)
SITE_URL=                  # Public site origin, e.g. https://www.banorachiropractic.com.au — used by health-check
ALERT_EMAIL=                # Recipient for health-check failure alerts
TELEGRAM_BOT_TOKEN=         # Optional — Telegram alert channel for health-check
TELEGRAM_CHAT_ID=           # Optional — Telegram chat ID for health-check alerts
SEND_RESEND_CONFIRMATION=   # "true" to also send a Resend booking confirmation (off by default)

# ── New — Banora SEO agent ──────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=      # From the downloaded Desktop-app OAuth client JSON — run scripts/gbp-oauth-setup.mjs
GOOGLE_OAUTH_CLIENT_SECRET=  # Same source as above — never commit this
GOOGLE_OAUTH_REFRESH_TOKEN=  # Printed once by scripts/gbp-oauth-setup.mjs — cannot be re-displayed, re-run the script if lost
GBP_ACCOUNT_ID=              # Printed by scripts/gbp-oauth-setup.mjs — the Business Profile account owning the Banora listing
GBP_LOCATION_ID=             # Printed by scripts/gbp-oauth-setup.mjs — the location ID for the Tweed Heads South clinic
SEARCH_CONSOLE_SITE_URL=     # Exact Search Console property URL, e.g. https://banorachiropractic.com.au/ or sc-domain:banorachiropractic.com.au
SEO_REPORT_EMAIL=            # Who receives the weekly SEO agent email
