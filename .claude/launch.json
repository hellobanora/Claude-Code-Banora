{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Banora Website (Astro)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 4321,
      "autoPort": false,
      "cwd": "banora-website"
    },
    {
      "name": "Banora Shift Tasks (Vite + React)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "Banora Chiro"
    },
    {
      "name": "PosturePro",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "posture-pro"
    },
    {
      "name": "Patient Forms",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8787"],
      "port": 8787,
      "cwd": "patient-forms"
    },
    {
      "name": "Patient App (prod build)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../banora-patient-app", "run", "start", "--", "-p", "3100"],
      "port": 3100
    },
    {
      "name": "ROF Builder",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["--yes", "serve", "-l", "8788"],
      "port": 8788,
      "cwd": "rof-builder"
    }
  ]
}
